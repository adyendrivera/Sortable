{
	"name": "sortable",
	"version": "0.1.0",
    "license": "MIT",
    "engines": {
        "node": ">=24",
        "pnpm": ">=10"
    },
	"packageManager": "pnpm@10.13.1",
	"description": "JavaScript library for reorderable drag-and-drop lists on modern browsers and touch devices. No jQuery required. Supports Meteor, AngularJS, React, Polymer, Vue, Knockout and any CSS library, e.g. Bootstrap.",
	"main": "./Sortable.min.js",
	"module": "modular/sortable.esm.js",
    "repository": {
        "type": "git",
        "url": "git://github.com/adyendrivera/Sortablee.git"
    },
	"files": [
        "dist/"
    ],
    "keywords": [
        "sortable",
        "reorder",
        "drag"
    ],
	"devDependencies": {
		"http-server": "14.1.1",
        "vite": "6.3.6",
		"testcafe": "^1.3.1",
		"testcafe-browser-provider-saucelabs": "^1.7.0",
		"testcafe-reporter-xunit": "^2.1.0"
	},
	"scripts": {
		"build": "vite build && pnpm run build:copy",
		"build:copy": "cp dist/sortable.umd.js public/sortable.js",
		"dev": "http-server public -p 3000",
		"dev1": "vite",
		"test:compat": "node ./scripts/test-compat.js",
		"test": "node ./scripts/test.js"
	}
}
