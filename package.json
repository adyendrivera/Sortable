{
    "name": "@adyen/sortable",
    "version": "0.1.0",
    "license": "MIT",
    "description": "JavaScript library for reorderable drag-and-drop lists on modern browsers and touch devices. No jQuery required. Supports Meteor, AngularJS, React, Polymer, Vue, Knockout and any CSS library, e.g. Bootstrap.",
    "main": "dist/sortable.umd.js",
    "module": "dist/sortable.es.js",
    "repository": {
        "type": "git",
        "url": "git://github.com/adyendrivera/Sortable.git"
    },
    "files": [
        "dist/"
    ],
    "keywords": [
        "sortable",
        "reorder",
        "drag"
    ],
    "scripts": {
        "build": "vite build",
        "dev": "vite",
        "build:watch": "set NODE_ENV=es&& rollup -w -c ./scripts/esm-build.js",
        "dev:http": "http-server public -p 3000",
        "test:compat": "node ./scripts/test-compat.js",
        "test": "node ./scripts/test.js"
    },
    "devDependencies": {
        "vite": "6.3.6",
        "http-server": "14.1.1",
        "testcafe": "^1.3.1",
        "testcafe-browser-provider-saucelabs": "^1.7.0",
        "testcafe-reporter-xunit": "^2.1.0"
    }
}
